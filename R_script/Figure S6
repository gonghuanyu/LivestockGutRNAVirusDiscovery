library(readr)
library(dplyr)
library(igraph)
library(ggraph)
library(ggplot2)
library(tidyr)

# -------------------------
# 1. Read pairwise sharing summary
# -------------------------
df <- read_csv("host_downsampling_pairwise_shared_summary.csv", show_col_types = FALSE)

# View first few rows
print(head(df))

# -------------------------
# 2. Build graph
# -------------------------
# Use shared proportion as edge weight; can also change to mean_shared_n
edges <- df %>%
  transmute(
    from = group1,
    to = group2,
    weight = mean_shared_prop,
    shared_n = mean_shared_n
  )

nodes <- data.frame(
  name = sort(unique(c(edges$from, edges$to))),
  stringsAsFactors = FALSE
)

g <- graph_from_data_frame(edges, directed = FALSE, vertices = nodes)

# Community detection (based on edge weights)
cl <- cluster_louvain(g, weights = E(g)$weight)
V(g)$module <- membership(cl)

cat("=== Modularity ===\n")
print(modularity(cl))

# -------------------------
# 3. Plot network
# -------------------------
set.seed(123)

p_net <- ggraph(g, layout = "fr") +
  geom_edge_link(aes(width = weight), alpha = 0.5, colour = "grey50") +
  geom_node_point(aes(color = factor(module)), size = 8) +
  geom_node_text(aes(label = name), repel = TRUE, size = 5) +
  scale_edge_width(range = c(0.5, 4)) +
  labs(
    title = "Host-sharing network after equal-size downsampling",
    subtitle = paste0("Edge width = mean shared proportion; modularity = ",
                      round(modularity(cl), 3)),
    color = "Module",
    edge_width = "Mean shared\nproportion"
  ) +
  theme_graph(base_size = 14)

ggsave("Host_sharing_network_modules.pdf", p_net, width = 8, height = 6)

# -------------------------
# 4. Plot heatmap
# -------------------------
# Build symmetric matrix
all_hosts <- sort(unique(c(df$group1, df$group2)))

mat <- matrix(0, nrow = length(all_hosts), ncol = length(all_hosts),
              dimnames = list(all_hosts, all_hosts))

for (i in seq_len(nrow(df))) {
  g1 <- df$group1[i]
  g2 <- df$group2[i]
  val <- df$mean_shared_prop[i]
  mat[g1, g2] <- val
  mat[g2, g1] <- val
}

diag(mat) <- NA

heat_df <- as.data.frame(mat) %>%
  tibble::rownames_to_column("Host1") %>%
  pivot_longer(-Host1, names_to = "Host2", values_to = "shared_prop")

p_heat <- ggplot(heat_df, aes(Host1, Host2, fill = shared_prop)) +
  geom_tile(color = "white") +
  scale_fill_gradient(low = "white", high = "firebrick", na.value = "grey95") +
  coord_equal() +
  theme_minimal(base_size = 14) +
  labs(
    title = "Pairwise host sharing after downsampling",
    fill = "Mean shared\nproportion",
    x = NULL,
    y = NULL
  ) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    panel.grid = element_blank()
  )

ggsave("Host_pairwise_sharing_heatmap.pdf", p_heat, width = 7, height = 6)

# -------------------------
# 5. Save module membership
# -------------------------
module_df <- data.frame(
  Host = names(membership(cl)),
  Module = as.integer(membership(cl)),
  stringsAsFactors = FALSE
)

write.csv(module_df, "Host_sharing_network_modules.csv", row.names = FALSE)

cat("=== Done ===\n")
